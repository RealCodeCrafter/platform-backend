NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=platform_admin
DB_SYNCHRONIZE=true

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

SEED_ON_BOOT=true
SEED_SUPER_USERNAME=super
SEED_SUPER_PASSWORD=SuperAdmin2026!
SEED_TRT_USERNAME=trt
SEED_TRT_PASSWORD=TrtAdmin2026!
SEED_GPG_USERNAME=gpg
SEED_GPG_PASSWORD=GpgAdmin2026!
SEED_VALESCO_USERNAME=valesco
SEED_VALESCO_PASSWORD=ValescoAdmin2026!
SEED_WINNER_USERNAME=winner
SEED_WINNER_PASSWORD=WinnerAdmin2026!
SEED_RTG_USERNAME=rtg
SEED_RTG_PASSWORD=RtgAdmin2026!

# Origin only. Do not add /api or a trailing path.
TRT_BASE_URL=https://backend.trt-parts.com
TRT_ADMIN_USERNAME=
TRT_ADMIN_PASSWORD=

GPG_BASE_URL=https://backend.gpggroup.uz
GPG_ADMIN_USERNAME=
GPG_ADMIN_PASSWORD=

