VALESCO_ADMIN_USERNAME=
VALESCO_ADMIN_PASSWORD=

WINNER_BASE_URL=https://backend.winnerlub.uz
WINNER_ADMIN_USERNAME=
WINNER_ADMIN_PASSWORD=

