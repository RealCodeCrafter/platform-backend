{
  "info": {
    "name": "Platform admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" },
    { "key": "siteSlug", "value": "trt" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"trt\",\n  \"password\": \"TrtAdmin2026!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Site-Slug", "value": "{{siteSlug}}" }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Site-Slug", "value": "{{siteSlug}}" }
            ],
            "url": "{{baseUrl}}/api/catalog/overview"
          }
        },
        {
          "name": "Schema",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Site-Slug", "value": "{{siteSlug}}" }
            ],
            "url": "{{baseUrl}}/api/catalog/schema"
          }
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Site-Slug", "value": "{{siteSlug}}" }
            ],
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Site-Slug", "value": "{{siteSlug}}" }
            ],
            "url": "{{baseUrl}}/api/products"
          }
        }
      ]
    }
  ]
}
